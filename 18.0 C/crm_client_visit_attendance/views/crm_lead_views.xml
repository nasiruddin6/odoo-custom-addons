<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit CRM Lead Form View -->
    <record id="view_crm_lead_form_inherit_crm_visit" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit.crm.visit</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">
                <button name="action_schedule_visit"
                        type="object"
                        class="btn-primary o_crm_button"
                        icon="fa-calendar-plus-o"
                        string="Schedule Visit"
                        groups="crm_client_visit_attendance.group_crm_visit_user"
                        invisible="partner_id.is_company == False"/>
            </xpath>
            <!-- Add Smart Button -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_visits"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-map-marker"
                        invisible="visit_count == 0"
                        groups="crm_client_visit_attendance.group_crm_visit_user">
                    <field name="visit_count" widget="statinfo" string="Visits"/>
                </button>
            </xpath>

            <!-- Add Last Visit Date -->
            <xpath expr="//field[@name='date_deadline']" position="after">
                <field name="last_visit_date" readonly="1"/>
            </xpath>

        </field>
    </record>

</odoo>

