<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- CRM Client Visit List View -->
    <record id="view_crm_client_visit_tree" model="ir.ui.view">
        <field name="name">crm.client.visit.list</field>
        <field name="model">crm.client.visit</field>
        <field name="arch" type="xml">
            <list string="Client Visits"
                  decoration-success="state == 'completed'"
                  decoration-info="state == 'in_progress'"
                  decoration-warning="state == 'review'"
                  decoration-danger="is_overdue == True"
                  decoration-muted="state in ('cancelled', 'missed')">
                <field name="name" string="Visit #"/>
                <field name="planned_datetime"/>
                <field name="client_id"/>
                <field name="lead_id" optional="hide"/>
                <field name="leader_employee_id"/>
                <field name="visit_employee_ids" widget="many2many_tags" optional="hide"/>
                <field name="visit_type"/>
                <field name="actual_check_in" optional="show"/>
                <field name="actual_check_out" optional="show"/>
                <field name="actual_duration" widget="float_time" optional="show"/>
                <field name="outcome" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'completed'"
                       decoration-info="state == 'in_progress'"
                       decoration-warning="state in ('planned', 'review')"
                       decoration-danger="state == 'missed'"
                       decoration-muted="state == 'cancelled'"/>
                <field name="is_overdue" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- CRM Client Visit Form View -->
    <record id="view_crm_client_visit_form" model="ir.ui.view">
        <field name="name">crm.client.visit.form</field>
        <field name="model">crm.client.visit</field>
        <field name="arch" type="xml">
            <form string="Client Visit">
                <header>
                    <button name="action_send_email"
                            string="Send"
                            type="object"
                            class="btn-primary"
                            icon="fa-paper-plane"
                            groups="crm_client_visit_attendance.group_crm_visit_user"/>
                    <button name="action_confirm"
                            string="Confirm Visit"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'draft'"
                            groups="crm_client_visit_attendance.group_crm_visit_user"/>
                    <button name="action_check_in"
                            string="Check In"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'planned'"
                            groups="crm_client_visit_attendance.group_crm_visit_user"/>
                    <button name="action_check_out"
                            string="Check Out"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'in_progress'"
                            groups="crm_client_visit_attendance.group_crm_visit_user"/>
                    <button name="action_approve"
                            string="Approve"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'review'"
                            groups="crm_client_visit_attendance.group_crm_visit_manager"/>
                    <button name="action_reject"
                            string="Reject"
                            type="object"
                            invisible="state != 'review'"
                            groups="crm_client_visit_attendance.group_crm_visit_manager"/>
                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            invisible="state in ('completed', 'cancelled', 'review')"
                            groups="crm_client_visit_attendance.group_crm_visit_user"/>
                    <button name="action_mark_missed"
                            string="Mark as Missed"
                            type="object"
                            invisible="state != 'planned'"
                            groups="crm_client_visit_attendance.group_crm_visit_manager"/>
                    <button name="action_set_to_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state in ('draft', 'completed', 'cancelled')"
                            groups="crm_client_visit_attendance.group_crm_visit_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,planned,in_progress,review,completed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_attendance"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-calendar-check-o"
                                invisible="attendance_count == 0">
                            <field name="attendance_count" widget="statinfo" string="Attendance"/>
                        </button>
                        <button name="action_view_activities"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-tasks"
                                invisible="activity_count == 0">
                            <field name="activity_count" widget="statinfo" string="Activities"/>
                        </button>
                        <button name="action_view_attachments"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-paperclip"
                                invisible="total_attachment_count == 0">
                            <field name="total_attachment_count" widget="statinfo" string="Attachments"/>
                        </button>
                    </div>

                    <widget name="web_ribbon" title="Overdue" bg_color="text-bg-danger"
                            invisible="is_overdue == False"/>
                    <widget name="web_ribbon" title="Completed" bg_color="text-bg-success"
                            invisible="state != 'completed'"/>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group name="visit_info" string="Visit Information">
                            <field name="client_id"
                                   options="{'no_create': True, 'no_open': True}"
                                   readonly="state != 'draft'"/>
                            <field name="lead_id"
                                   options="{'no_create': True}"
                                   readonly="state != 'draft'"/>
                            <field name="leader_employee_id"
                                   options="{'no_create': True}"
                                   readonly="state != 'draft'"/>
                            <field name="visit_employee_ids"
                                   widget="many2many_tags"
                                   options="{'no_create': True}"
                                   placeholder="Add team members..."
                                   readonly="state != 'draft'"/>
                            <field name="user_id" invisible="1"/>
                            <field name="visit_type"
                                   readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company"
                                   readonly="state != 'draft'"/>
                        </group>
                        <group name="schedule" string="Schedule">
                            <field name="planned_datetime"
                                   readonly="state != 'draft'"/>
                            <field name="expected_duration" widget="float_time"
                                   readonly="state != 'draft'"/>
                            <field name="actual_duration" widget="float_time"
                                   readonly="1"
                                   invisible="state != 'completed'"/>
                        </group>
                    </group>

                    <group name="client_info" string="Client Information">
                        <group>
                            <field name="contact_person"
                                   placeholder="Enter contact person name"
                                   readonly="state != 'draft'"/>
                            <field name="contact_designation"
                                   placeholder="e.g., Manager, Director, etc."
                                   readonly="state != 'draft'"/>
                            <field name="contact_phone"
                                   widget="phone"
                                   placeholder="+1 234 567 8900"
                                   readonly="state != 'draft'"/>
                            <field name="contact_email"
                                   widget="email"
                                   placeholder="contact@company.com"
                                   readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="client_address"
                                   placeholder="Enter full address where visit will take place"
                                   readonly="state != 'draft'"/>
                            <label for="client_gps_latitude" string="GPS Location (Optional)"/>
                            <div class="o_row">
                                <field name="client_gps_latitude"
                                       placeholder="Latitude"
                                       readonly="state != 'draft'"/>
                                <span>, </span>
                                <field name="client_gps_longitude"
                                       placeholder="Longitude"
                                       readonly="state != 'draft'"/>
                            </div>
                        </group>
                    </group>

                    <group name="purpose_group">
                        <field name="purpose"
                               placeholder="Describe the purpose of this visit..."
                               readonly="state != 'draft'"/>
                    </group>

                    <notebook>
                        <page name="checkin_details" string="Check-In/Out Details"
                              invisible="state in ('draft', 'planned')">
                            <group>
                                <group name="checkin" string="Check-In">
                                    <field name="actual_check_in" readonly="1"/>
                                    <label for="check_in_latitude"/>
                                    <div class="o_row">
                                        <field name="check_in_latitude" readonly="1"/>
                                        <span>, </span>
                                        <field name="check_in_longitude" readonly="1"/>
                                    </div>
                                </group>
                                <group name="checkout" string="Check-Out">
                                    <field name="actual_check_out" readonly="1"/>
                                    <label for="check_out_latitude"
                                           invisible="actual_check_out == False"/>
                                    <div class="o_row" invisible="actual_check_out == False">
                                        <field name="check_out_latitude" readonly="1"/>
                                        <span>, </span>
                                        <field name="check_out_longitude" readonly="1"/>
                                    </div>
                                </group>
                            </group>
                        </page>

                        <page name="outcome" string="Outcome"
                              invisible="state not in ('completed', 'missed', 'review')">
                            <group>
                                <group>
                                    <field name="outcome"/>
                                    <field name="interest_level" widget="percentage"/>
                                    <field name="next_action_required"/>
                                </group>
                                <group>
                                    <field name="expected_value"
                                           invisible="visit_type not in ('sales', 'relationship')"
                                           widget="monetary"/>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="followup_activity_id" readonly="1"/>
                                </group>
                            </group>
                            <group>
                                <field name="notes" placeholder="Enter visit notes and observations..."/>
                            </group>
                            <group>
                                <field name="next_action"
                                       placeholder="What are the next steps?"
                                       invisible="next_action_required != 'yes'"/>
                            </group>
                        </page>

                        <page name="attendance" string="Attendance">
                            <field name="attendance_ids">
                                <list>
                                    <field name="employee_id"/>
                                    <field name="check_in"/>
                                    <field name="check_out"/>
                                    <field name="duration" widget="float_time"/>
                                    <field name="attendance_type" widget="badge"/>
                                </list>
                            </field>
                        </page>

                        <page name="attachments" string="Attachments">
                            <group>
                                <group string="Photos" name="photos_group">
                                    <field name="photo_ids" widget="many2many_binary" nolabel="1">
                                        <list>
                                            <field name="name"/>
                                            <field name="create_date"/>
                                            <field name="create_uid"/>
                                        </list>
                                    </field>
                                </group>
                                <group string="Documents" name="documents_group">
                                    <field name="document_ids" widget="many2many_binary" nolabel="1">
                                        <list>
                                            <field name="name"/>
                                            <field name="create_date"/>
                                            <field name="create_uid"/>
                                        </list>
                                    </field>
                                </group>
                            </group>
                            <group>
                                <group string="Signed Forms" name="signed_forms_group">
                                    <field name="signed_form_ids" widget="many2many_binary" nolabel="1">
                                        <list>
                                            <field name="name"/>
                                            <field name="create_date"/>
                                            <field name="create_uid"/>
                                        </list>
                                    </field>
                                </group>
                                <group string="Visiting Cards" name="visiting_cards_group">
                                    <field name="visiting_card_ids" widget="many2many_binary" nolabel="1">
                                        <list>
                                            <field name="name"/>
                                            <field name="create_date"/>
                                            <field name="create_uid"/>
                                        </list>
                                    </field>
                                </group>
                            </group>
                        </page>

                        <page name="remarks" string="Remarks">
                            <separator string="Internal Notes"/>
                            <group>
                                <field name="internal_notes"
                                       placeholder="Enter internal notes for team reference (not visible to client)..."
                                       nolabel="1"/>
                            </group>
                            <separator string="Client Remarks"/>
                            <group>
                                <field name="client_remarks"
                                       placeholder="Enter remarks or feedback from the client..."
                                       nolabel="1"/>
                            </group>
                        </page>
                    </notebook>

                </sheet>
                <chatter/>
                <field name="is_overdue" invisible="1"/>
            </form>
        </field>
    </record>

    <!-- CRM Client Visit Kanban View -->
    <record id="view_crm_client_visit_kanban" model="ir.ui.view">
        <field name="name">crm.client.visit.kanban</field>
        <field name="model">crm.client.visit</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="state">
                <field name="name"/>
                <field name="client_id"/>
                <field name="leader_employee_id"/>
                <field name="planned_datetime"/>
                <field name="visit_type"/>
                <field name="state"/>
                <field name="is_overdue"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                </div>
                                <span class="badge text-bg-primary" t-if="record.is_overdue.raw_value">
                                    Overdue
                                </span>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="client_id"/>
                                <br/>
                                <span class="text-muted">
                                    <i class="fa fa-user"/> <field name="leader_employee_id"/>
                                </span>
                                <br/>
                                <span class="text-muted">
                                    <i class="fa fa-calendar"/> <field name="planned_datetime"/>
                                </span>
                                <br/>
                                <span class="badge"
                                      t-att-class="{'sales': 'text-bg-success', 'support': 'text-bg-info', 'collection': 'text-bg-warning', 'relationship': 'text-bg-primary', 'inspection': 'text-bg-secondary'}[record.visit_type.raw_value]">
                                    <field name="visit_type"/>
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- CRM Client Visit Calendar View -->
    <record id="view_crm_client_visit_calendar" model="ir.ui.view">
        <field name="name">crm.client.visit.calendar</field>
        <field name="model">crm.client.visit</field>
        <field name="arch" type="xml">
            <calendar string="Client Visits"
                      date_start="planned_datetime"
                      color="leader_employee_id"
                      mode="month"
                      event_open_popup="true"
                      quick_create="0">
                <field name="client_id"/>
                <field name="leader_employee_id"/>
                <field name="visit_type"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

