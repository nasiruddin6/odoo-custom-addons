    <!-- CRM Client Visit Actions -->
    <record id="action_crm_client_visit" model="ir.actions.act_window">
        <field name="name">Client Visits</field>
        <field name="res_model">crm.client.visit</field>
        <field name="view_mode">list,form,kanban,calendar</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Schedule a new client visit
            </p>
            <p>
                Plan and track client visits with GPS-based attendance tracking.
                Check in and check out from visits to automatically record attendance.
            </p>
        </field>
    </record>

    <record id="action_crm_client_visit_my" model="ir.actions.act_window">
        <field name="name">My Visits</field>
        <field name="res_model">crm.client.visit</field>
        <field name="view_mode">list,form,kanban,calendar</field>
        <field name="context">{'search_default_my_visits': 1, 'search_default_planned': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Schedule your first client visit
            </p>
            <p>
                View and manage your planned and completed client visits.
            </p>
        </field>
    </record>

</odoo>

