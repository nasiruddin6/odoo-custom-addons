<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- List view for crm property visit -->
        <record id="view_crm_property_visit_list" model="ir.ui.view">
            <field name="name">crm.property.visit.list</field>
            <field name="model">crm.property.visit</field>
            <field name="arch" type="xml">
                <list string="Property Visits">
                    <field name="name"/>
                </list>
            </field>
        </record>

        <!-- Form View for crm property visit -->
        <record id="view_crm_property_visit_form" model="ir.ui.view">
            <field name="name">crm.property.visit.form</field>
            <field name="model">crm.property.visit</field>
            <field name="arch" type="xml">
                <form string="Property Visit">
                    <header>
                        <field name="state" widget="statusbar" readonly="0" statusbar_visible="draft,planned,completed"/>
                    </header>

                    <sheet>

                        <div class="oe_title">
                            <h1>
                                <field name="priority" widget="priority" nolabel="1" class="oe_inline align-top"/>
                            </h1>
                            <h1>
                                <field name="name" nolabel="1" readonly="1" placeholder="NEW VISITING"/>
                            </h1>
                        </div>

                        <group>
                            <group>
                                <field name="lead_id"/>
                                <field name="visit_date"/>
                                <field name="visit_start_time" widget="daterange" options="{'end_date_field': 'visit_end_time'}"
                                       invisible="not visit_date" readonly="state != 'draft'"/>
                                <field name="visit_end_time" invisible="1"/>
                                <field name="duration" invisible="not visit_date" widget="float_time"/>
                                <field name="visit_purpose"/>
                            </group>
                            <group >
                                <field name="property_id" required="1" />
                                <field name="unit_id" required="1"/>
                                <field name="user_id" widget="many2one_avatar_user" required="1" string="Primary Agent"/>
                                <field name="user_ids" widget="many2many_tags" string="Additional Agents"/>
                                <field name="team_id" />
                            </group>
                        </group>
                        <notebook>
                            <page name="extra_info" string="Extra Information">
                                <group>
                                    <group  name="contact_info" string="Contact Information">
                                        <field name="partner_id"/>
                                        <field name="phone" widget="phone"/>
                                        <field name="email" widget="email"/>
                                        <field name="attendees_number"/>
                                        <field name="special_request"/>
                                    </group>
                                    <group name="location_and_logisitics" string="Location &amp; Logistics">
                                        <field name="meeting_point"/>
                                        <field name="map_link" widget="url"/>
                                        <field name="expected_travel_time" widget="float_time"/>
                                        <field name="transport_mode"/>
                                        <field name="is_parking_required"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action to open visits -->
        <record id="action_crm_property_visit" model="ir.actions.act_window">
            <field name="name">Property Visits</field>
            <field name="res_model">crm.property.visit</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Schedule and manage property visits here.
                </p>
            </field>
        </record>
</odoo>
