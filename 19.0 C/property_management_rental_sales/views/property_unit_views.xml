<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Action for units -->
        <record id="action_property_unit" model="ir.actions.act_window">
            <field name="name">Units</field>
            <field name="res_model">property.unit</field>
            <field name="view_mode">kanban,list,form</field>
	        <field name="context">{'search_default_property': 1}</field>
        </record>

        <!-- Kanban view -->
        <record id="view_property_unit_kanban" model="ir.ui.view">
            <field name="name">property.unit.kanban</field>
            <field name="model">property.unit</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_property_unit">
                    <field name="name"/>
                    <field name="property_id"/>
                    <field name="state"/>
                    <field name="rent_price"/>
	                <field name="sale_price"/>
	                <field name="owner_name"/>
	                <field name="image_1024"/>
	                <field name="property_for"/>
                    <templates>
	                    <t t-name="card" class="flex-row">
		                    <aside>
			                    <field name="image_1024" widget="image" class="oe_avatar" nolabel="1"
			                           readonly="state !='draft'"/>
		                    </aside>
		                    <main class="ms-2">
			                    <div>
				                    <field name="state" widget="badge" class="float-end"
				                           decoration-success="state == 'available'"
				                           decoration-primary="state in ['leased', 'rented']"
				                           decoration-info="state == 'booked'"
				                           decoration-danger="state == 'in_maintenance'"
				                           decoration-warning="state == 'sold'"/>
				                    <field name="name" class="fw-bold fs-5" placeholder="Unit"/>
			                    </div>
			                    <div>Property:
				                    <field name="property_id"/>
			                    </div>
			                    <div t-if="record.owner_name.raw_value">
				                    <strong>Owner:</strong>
				                    <field name="owner_name"/>
			                    </div>
			                    <div t-if="record.rent_price.raw_value">Rent:
				                    <field name="rent_price"/>
			                    </div>
			                    <div t-if="record.sale_price.raw_value">Sale:
				                    <field name="sale_price"/>
			                    </div>
		                    </main>
	                    </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- List view -->
        <record id="view_property_unit_list" model="ir.ui.view">
            <field name="name">property.unit.list</field>
            <field name="model">property.unit</field>
            <field name="arch" type="xml">
                <list string="Units">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="property_id"/>
                    <field name="unit_type_id"/>
                    <field name="state"/>
                    <field name="area_sqft"/>
                    <field name="bedroom"/>
                    <field name="bathroom"/>
                    <field name="rent_price"/>
                    <field name="landlord_id"/>
                    <field name="partner_id"/>
                    <field name="owner_name"/>
                </list>
            </field>
        </record>

        <!-- Form view -->
        <record id="view_property_unit_form" model="ir.ui.view">
            <field name="name">property.unit.form</field>
            <field name="model">property.unit</field>
            <field name="arch" type="xml">
                <form string="Unit">
                    <header>
                        <button name="create_new_contract" string="Create Contract" type="object"
                                class="btn-primary" invisible="state != 'available'"/>
                        <button name="set_available" string="Set to Available" type="object"
                                invisible="state not in ('draft', 'maintenance')"/>
                        <button name="action_to_draft" string="To Draft" type="object"
                                invisible="state != 'available'"/>
                        <button name="action_create_maintenance_request" string="Create Maintenance Request"
                                type="object"
                                invisible="state == 'draft'"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,available,rented"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_contracts" type="object" class="oe_stat_button"
                                    icon="fa-file-text-o" invisible="property_for == 'sale'">
                                <field name="contract_count" widget="statinfo" string="Contracts"/>
                            </button>

                            <button name="action_view_sales_contracts" type="object" class="oe_stat_button"
                                    icon="fa-file-text-o" invisible="property_for != 'sale'">
                                <field name="sales_contract_count" widget="statinfo" string="Sales Contracts"/>
                            </button>
                        </div>
                        <group>
                            <group>
                                <field name="name" readonly="state !='draft'"/>
                                <field name="code" readonly="state !='draft'"/>
                                <field name="property_id" readonly="state !='draft'"/>
                                <field name="property_for" readonly="state !='draft'"/>
	                            <field name="partner_domain" invisible="1"/>
	                            <label for="partner_id" string="Tenant" invisible="property_for == 'sale'"/>
                                <label for="partner_id" string="Customer" invisible="property_for != 'sale'" domain="partner_domain"/>
                                <field name="partner_id" readonly="state not in ('draft', 'available')" nolabel="1" options="{'no_create': True}" domain="partner_domain"/>
                            </group>
                            <group>
                                <field name="image_1024" widget="image" class="oe_avatar" nolabel="1"
                                       readonly="state !='draft'"/>
                            </group>
                        </group>

                        <group string="Unit Details">
                            <group>
                                <field name="floor" readonly="state !='draft'"/>
                                <field name="building" readonly="state !='draft'"/>
                                <field name="area_sqft" readonly="state !='draft'"/>
                                <field name="area_sqm" readonly="state !='draft'"/>
                                <field name="unit_category" readonly="state !='draft'"/>
                                <field name="furnishing_type" readonly="state !='draft'"/>
                                <field name="facing" readonly="state !='draft'"/>
                            </group>
                            <group>
                                <field name="property_unit_type_id" readonly="state !='draft'" widget="selection"/>
                                <field name="bedroom" readonly="state !='draft'"/>
                                <field name="living" readonly="state !='draft'"/>
                                <field name="dining" readonly="state !='draft'"/>
                                <field name="kitchen" readonly="state !='draft'"/>
                                <field name="bathroom" readonly="state !='draft'"/>
                                <field name="balcony" readonly="state !='draft'"/>
                                <field name="parking" readonly="state !='draft'"/>
                            </group>
                        </group>

                        <group string="Pricing &amp; Parties">
                            <group>
                                <field name="rent_price" invisible="property_for == 'sale'" readonly="state !='draft'"/>
                                <field name="sale_price" invisible="property_for in ('rent', 'lease')"
                                       readonly="state !='draft'"/>
                                <field name="currency_id" readonly="state !='draft'"/>
                            </group>
                            <group>
                                <field name="landlord_id" options="{'no_create': True}" readonly="state !='draft'"/>
                                <field name="company_id" readonly="state !='draft'"/>
                            </group>

                        </group>

                        <notebook>
                            <page string="Owner / Business">
                                <group>
                                    <group>
                                        <field name="owner_partner_id" readonly="state !='draft'"/>
                                        <field name="owner_name" readonly="1"/>
                                        <field name="owner_email" readonly="1"/>
                                        <field name="owner_phone" readonly="1"/>
                                        <field name="owner_is_company" readonly="1"/>
                                        <field name="owner_vat" readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="owner_company_registration" readonly="state !='draft'"/>
                                        <field name="owner_notes" readonly="state !='draft'"/>
                                    </group>
                                </group>
                            </page>

                            <page string="Address &amp; Location">
                                <group>
                                    <group>
                                        <field name="street" readonly="state !='draft'"/>
                                        <field name="street2" readonly="state !='draft'"/>
                                        <field name="city_id" readonly="state !='draft'"/>
                                        <field name="zip" readonly="state !='draft'"/>
                                        <field name="state_id" readonly="state !='draft'"/>
                                        <field name="country_id" readonly="state !='draft'"/>
                                    </group>
                                    <group>
                                        <field name="latitude" readonly="state !='draft'"/>
                                        <field name="longitude" readonly="state !='draft'"/>
                                    </group>
                                </group>
                            </page>

                            <page string="Features">
                                <group>
                                    <field name="amenity_ids" widget="many2many_tags" readonly="state !='draft'"/>
                                    <field name="specification_ids" widget="many2many_tags" readonly="state !='draft'"/>
                                    <field name="connectivity_ids" widget="many2many_tags" readonly="state !='draft'"/>
                                </group>
                                <group>
                                </group>
                            </page>

                            <page string="Dates &amp; Media">
                                <group>
                                    <group>
                                        <field name="is_available" readonly="state !='draft'"/>
                                        <field name="availability_date" readonly="state !='draft'"/>
                                        <field name="construction_year" readonly="state !='draft'"/>
                                    </group>
                                    <group>
                                        <field name="description" readonly="state !='draft'"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Search view -->
        <record id="view_property_unit_search" model="ir.ui.view">
            <field name="name">property.unit.search</field>
            <field name="model">property.unit</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="property_id"/>
                    <field name="unit_category"/>
                    <field name="landlord_id"/>
                    <field name="partner_id"/>
                    <field name="owner_partner_id"/>
                    <separator/>
                    <filter string="Available" name="available" domain="[('state', '=', 'available')]"/>
                    <filter string="Rented" name="rented" domain="[('state', '=', 'rented')]"/>
                    <filter string="Sold" name="sold" domain="[('state', '=', 'sold')]"/>
                    <filter string="For Rent" name="for_rent" domain="[('property_for', '=', 'rent')]"/>
                    <filter string="For Sale" name="for_sale" domain="[('property_for', '=', 'sale')]"/>
                    <separator/>
                    <filter string="Unit Category" name="unit_category" domain="[]"
                            context="{'group_by': 'unit_category'}"/>
                    <filter string="Property" name="property" domain="[]" context="{'group_by': 'property_id'}"/>
                    <filter string="State" name="state" domain="[]" context="{'group_by': 'state'}"/>
                </search>
            </field>
        </record>
</odoo>
