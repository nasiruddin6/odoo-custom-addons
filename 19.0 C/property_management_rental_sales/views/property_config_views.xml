        <record id="action_property_agreement_template" model="ir.actions.act_window">
            <field name="name">Agreement Templates</field>
            <field name="res_model">property.agreement.template</field>
            <field name="view_mode">list,form</field>
        </record>
        <record id="view_property_agreement_template_list" model="ir.ui.view">
            <field name="name">property.agreement.template.list</field>
            <field name="model">property.agreement.template</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="active" invisible="1"/>
                </list>
            </field>
        </record>
        <record id="view_property_agreement_template_form" model="ir.ui.view">
            <field name="name">property.agreement.template.form</field>
            <field name="model">property.agreement.template</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="content"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

