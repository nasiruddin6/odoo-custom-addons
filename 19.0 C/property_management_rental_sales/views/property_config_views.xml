        <!-- property.duration -->
        <record id="action_property_duration" model="ir.actions.act_window">
            <field name="name">Durations</field>
            <field name="res_model">property.duration</field>
            <field name="view_mode">list,form</field>
        </record>
        <record id="view_property_duration_list" model="ir.ui.view">
            <field name="name">property.duration.list</field>
            <field name="model">property.duration</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="duration"/>
                    <field name="duration_unit"/>
                    <field name="active" invisible="1"/>
                </list>
            </field>
        </record>
        <record id="view_property_duration_form" model="ir.ui.view">
            <field name="name">property.duration.form</field>
            <field name="model">property.duration</field>
            <field name="arch" type="xml">
                <form>
	                <header>
		                <button name="action_confirm_duration" string="Confirm" invisible="state != 'draft'"
		                        type="object" class="oe_highlight"/>
		                <button name="action_set_to_draft" string="Set to Draft" invisible="state != 'confirm'"
		                        type="object" class="btn-secondary"/>
		                <field name="state" widget="statusbar"
		                       statusbar_visible="draft,confirm"/>
	                </header>
	                <sheet>
                        <group>
                            <field name="name" readonly="state == 'confirm'"/>
                            <field name="duration" readonly="state == 'confirm'"/>
                            <field name="duration_unit" readonly="state == 'confirm'"/>
                            <field name="description" readonly="state == 'confirm'"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

