        <record id="view_property_unit_type_form" model="ir.ui.view">
            <field name="name">property.unit.type.form</field>
            <field name="model">property.unit.type</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
	                    <div class="oe_title">
		                    <h1>
			                    <field name="name" required="1" nolabel="1" placeholder="Unit Type"/>
		                    </h1>
	                    </div>
	                    <group>
		                    <group string="Attributes">
			                    <field name="bedroom"/>
			                    <field name="living"/>
			                    <field name="dining"/>
			                    <field name="kitchen"/>
			                    <field name="bathroom"/>
			                    <field name="balcony"/>
			                    <field name="parking"/>
			                    <field name="active" invisible="1"/>
		                    </group>
	                    </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
