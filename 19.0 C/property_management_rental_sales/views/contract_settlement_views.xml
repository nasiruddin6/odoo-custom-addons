<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Contract Settlement Form View -->
    <record id="view_contract_settlement_form" model="ir.ui.view">
        <field name="name">contract.settlement.form</field>
        <field name="model">contract.settlement</field>
        <field name="arch" type="xml">
            <form string="Contract Settlement">
                <header>
                    <button name="action_confirm" string="Confirm" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_done" string="Mark as Done" type="object"
                            class="oe_highlight" invisible="state != 'settled'"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object"
                            invisible="state not in ['confirmed', 'cancelled']"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ['done', 'cancelled']"/>
                    <button name="action_launch_settlement_wizard" string="Settlement" type="object"
                            class="btn-primary" invisible="state != 'confirmed' or credit_note_id"/>
                    <button name="action_print_settlement" string="Print" type="object"
                            invisible="state == 'draft'"/>
                    <button name="action_recompute_settlement" string="Recompute" class="btn-primary" type="object"
                            invisible="state not in ['draft', 'confirmed']"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_contract" type="object"
                                class="oe_stat_button" icon="fa-file-text-o">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Contract</span>
                            </div>
                        </button>
                        <button name="action_view_invoices" type="object"
                                class="oe_stat_button" icon="fa-money"
                                invisible="paid_invoice_count == 0">
                            <field name="paid_invoice_count" widget="statinfo"
                                   string="Paid Invoices"/>
                        </button>
	                    <button name="action_view_credit_notes" type="object" class="oe_stat_button"
	                            icon="fa-pencil-square-o" invisible="not credit_note_count">
		                    <field name="credit_note_count" widget="statinfo" string="Credit Notes"/>
	                    </button>
	                    <button name="action_view_unpaid_invoices" type="object"
                                class="oe_stat_button" icon="fa-exclamation-triangle"
                                invisible="unpaid_invoice_count == 0">
                            <field name="unpaid_invoice_count" widget="statinfo"
                                   string="Unpaid Invoices"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="contract_id"
                                   options="{'no_create': True}"
                                   readonly="state != 'draft'"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="landlord_id" readonly="1"/>
                            <field name="property_id" readonly="1"/>
                            <field name="unit_id" readonly="1"/>
                        </group>
	                    <group>
		                    <field name="actual_end_date" readonly="state == 'done'" string="Move out date"/>
		                    <field name="settlement_date" readonly="state != 'draft'"/>
		                    <field name="settlement_type" readonly="state != 'draft'"/>
		                    <field name="responsible_user_id" readonly="state == 'done'"/>
		                    <field name="company_id" invisible="1"/>
		                    <field name="currency_id" invisible="1"/>
	                    </group>
                    </group>

                    <notebook>
                        <page string="Settlement Summary" name="summary">
                            <field name="settlement_summary" nolabel="1" readonly="1"/>
                        </page>

                        <page string="Settlement Details" name="settlement_details">
                            <group>
                                <group string="Date Information">
                                    <field name="contract_start_date" readonly="1"/>
                                    <field name="contract_end_date" readonly="1"/>
                                    <field name="notice_date" readonly="state == 'done'"/>
                                </group>
                                <group string="Rental Period">
                                    <field name="days_occupied" readonly="1"/>
                                    <field name="remaining_days" readonly="1"/>
                                    <field name="rent_per_day" readonly="1"
                                           widget="monetary"/>
                                </group>
                            </group>

                            <group string="Termination Reason">
                                <field name="termination_reason" nolabel="1"
                                       placeholder="Please provide detailed reason for settlement..."
                                       readonly="state == 'done'"/>
                            </group>
                        </page>
                        <page string="Financial Breakdown" name="financial">
                            <group>
                                <group string="Rent Details">
                                    <field name="total_rent" widget="monetary"
                                           readonly="state == 'done'"/>
	                                <field name="unpaid_rent" widget="monetary"
	                                       readonly="state == 'done'"/>
	                                <field name="security_deposit" widget="monetary"
	                                       readonly="state == 'done'"/>
	                                <field name="total_paid" widget="monetary"
                                           readonly="state == 'done'"/>
	                                <field name="occupied_rent" widget="monetary"
	                                       readonly="state == 'done'"/>
                                </group>

	                            <group string="Outstanding Charges &amp; Deductions">
		                            <field name="refund_amount" widget="monetary"
		                                   readonly="state == 'done'" invisible="not refund_amount"/>
		                            <field name="maintenance_charges" widget="monetary"
		                                   readonly="state == 'done'"/>
		                            <field name="utility_charges" widget="monetary"
		                                   readonly="state == 'done'"/>
		                            <field name="penalty_charges" widget="monetary"
		                                   readonly="state == 'done'"/>
		                            <field name="fees" widget="monetary"
		                                   readonly="state == 'done'"/>
		                            <field name="other_charges" widget="monetary"
		                                   readonly="state == 'done'"/>
		                            <field name="other_charges_description"
		                                   placeholder="Describe other charges..."
		                                   readonly="state == 'done'"
		                                   invisible="not other_charges"/>
	                            </group>
                            </group>

	                        <group>
                                <group string="Settlement Summary" class="oe_subtotal_footer">
                                    <field name="net_payable" widget="monetary"
                                           readonly="1"
                                           class="oe_subtotal_footer_separator"
                                           decoration-success="net_payable &gt; 0"
                                           decoration-danger="net_payable &lt; 0"/>
                                    <field name="amount" widget="monetary"
                                           readonly="1"
                                           class="oe_subtotal_footer_separator"/>
                                </group>
                            </group>
                        </page>

                        <page string="Property Condition" name="property_condition">
                            <group>
                                <group>
                                    <field name="inspection_date" readonly="state == 'done'"/>
                                    <field name="property_condition" readonly="state == 'done'"/>
                                </group>
                                <group>
                                </group>
                            </group>
                            <group string="Inspection Notes">
                                <field name="inspection_notes" nolabel="1"
                                       placeholder="Inspection findings and notes..."
                                       readonly="state == 'done'"/>
                            </group>
                            <group string="Damage Description">
                                <field name="damage_description" nolabel="1"
                                       placeholder="Describe any damages found during inspection..."
                                       readonly="state == 'done'"/>
                            </group>
                        </page>

                        <page string="Payment Details" name="payment">
                            <group>
                                <group>
                                    <field name="payment_method" readonly="state == 'done'"/>
                                    <field name="payment_reference" readonly="state == 'done'"/>
                                    <field name="payment_date" readonly="state == 'done'"/>
                                    <field name="bank_account_id" readonly="state == 'done'"
                                           domain="[('partner_id', '=', partner_id)]"
                                           context="{'default_partner_id': partner_id}"/>
                                </group>
                                <group>
                                    <field name="journal_id" readonly="state == 'done'"/>
                                    <field name="move_id" readonly="1"/>
                                    <field name="credit_note_id" readonly="1"/>
                                    <field name="invoice_id" readonly="1"/>
                                    <field name="reconciled" readonly="state != 'done'"/>
                                </group>
                            </group>
                        </page>

                        <page string="Related Invoices" name="invoices">
                            <field name="invoice_ids" readonly="state == 'done'">
                                <list>
                                    <field name="name"/>
                                    <field name="invoice_date"/>
                                    <field name="invoice_date_due"/>
                                    <field name="amount_total"/>
                                    <field name="amount_residual"/>
                                    <field name="payment_state"
                                           decoration-success="payment_state == 'paid'"
                                           decoration-warning="payment_state == 'partial'"
                                           decoration-danger="payment_state == 'not_paid'"/>
                                </list>
                            </field>
                        </page>

                        <page string="Documentation" name="documentation">
                            <group>
                                <group string="Settlement Documents">
                                    <field name="settlement_agreement"
                                           filename="settlement_agreement_filename"
                                           readonly="state == 'done'"/>
                                    <field name="settlement_agreement_filename" invisible="1"/>
                                    <field name="handover_certificate"
                                           filename="handover_certificate_filename"
                                           readonly="state == 'done'"/>
                                    <field name="handover_certificate_filename" invisible="1"/>
                                </group>
                                <group string="Additional Documents">
                                    <field name="inspection_report"
                                           filename="inspection_report_filename"
                                           readonly="state == 'done'"/>
                                    <field name="inspection_report_filename" invisible="1"/>
                                    <field name="tenant_acknowledgement"
                                           filename="tenant_acknowledgement_filename"
                                           readonly="state == 'done'"/>
                                    <field name="tenant_acknowledgement_filename" invisible="1"/>
                                </group>
                            </group>
                        </page>

                        <page string="Approval" name="approval" invisible="state == 'draft'">
                            <group>
                                <group>
                                    <field name="approved_by" readonly="1"/>
                                    <field name="approval_date" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Contract Settlement list View -->
    <record id="view_contract_settlement_list" model="ir.ui.view">
        <field name="name">contract.settlement.list</field>
        <field name="model">contract.settlement</field>
        <field name="arch" type="xml">
            <list string="Contract Settlements"
                  decoration-muted="state == 'cancelled'"
                  decoration-success="state == 'done'"
                  decoration-info="state == 'confirmed'">
                <field name="name"/>
                <field name="contract_id"/>
                <field name="partner_id"/>
                <field name="property_id"/>
                <field name="settlement_date"/>
                <field name="settlement_type"/>
                <field name="amount" widget="monetary"/>
                <field name="net_payable" widget="monetary"
                       decoration-success="net_payable &gt; 0"
                       decoration-danger="net_payable &lt; 0"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state == 'confirmed'"
                       decoration-muted="state == 'cancelled'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Contract Settlement Search View -->
    <record id="view_contract_settlement_search" model="ir.ui.view">
        <field name="name">contract.settlement.search</field>
        <field name="model">contract.settlement</field>
        <field name="arch" type="xml">
            <search string="Contract Settlements">
                <field name="name" string="Settlement Reference"/>
                <field name="contract_id" string="Contract"/>
                <field name="partner_id" string="Tenant"/>
                <field name="property_id" string="Property"/>
                <field name="settlement_type"/>

                <filter string="Draft" name="draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed"
                        domain="[('state', '=', 'confirmed')]"/>
                <filter string="Done" name="done"
                        domain="[('state', '=', 'done')]"/>
                <filter string="Cancelled" name="cancelled"
                        domain="[('state', '=', 'cancelled')]"/>

                <separator/>
                <filter string="Early Termination" name="early_termination"
                        domain="[('settlement_type', '=', 'early_termination')]"/>
                <filter string="Normal End" name="normal_end"
                        domain="[('settlement_type', '=', 'normal_end')]"/>
                <filter string="Contract Breach" name="breach"
                        domain="[('settlement_type', '=', 'breach')]"/>

                <separator/>
                <filter string="Refund Due" name="refund_due"
                        domain="[('net_payable', '&gt;', 0)]"/>
                <filter string="Amount Due from Tenant" name="amount_due"
                        domain="[('net_payable', '&lt;', 0)]"/>

                <separator/>
                <filter string="Settlement Date" name="filter_settlement_date"
                        date="settlement_date"/>
            </search>
        </field>
    </record>

    <!-- Contract Settlement Kanban View -->
    <record id="view_contract_settlement_kanban" model="ir.ui.view">
        <field name="name">contract.settlement.kanban</field>
        <field name="model">contract.settlement</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="contract_id"/>
                <field name="partner_id"/>
                <field name="settlement_date"/>
                <field name="amount"/>
                <field name="state"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                </div>
                                <field name="state" widget="label_selection"
                                       options="{'classes': {'draft': 'default', 'confirmed': 'info', 'done': 'success', 'cancelled': 'danger'}}"/>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="contract_id"/>
                                <br/>
                                <field name="partner_id"/>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="settlement_date"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <strong><field name="amount" widget="monetary"/></strong>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Contract Settlement Action -->
    <record id="action_contract_settlement" model="ir.actions.act_window">
        <field name="name">Contract Settlements</field>
        <field name="res_model">contract.settlement</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_draft': 1, 'search_default_confirmed': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Contract Settlement
            </p>
            <p>
                Manage contract settlements including security deposit refunds,
                damage assessments, and final rental period calculations.
            </p>
        </field>
    </record>
</odoo>
