<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="confirm_property_wizard_form" model="ir.ui.view">
            <field name="name">confirm.property.wizard.form</field>
            <field name="model">confirm.property.wizard</field>
            <field name="arch" type="xml">
                <form string="Confirm Property">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="lead_id" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <!-- Hidden field for domain -->
                            <field name="available_property_unit_ids" invisible="1"/>
                            <!-- Unit selection with proper domain syntax -->
                            <field name="unit_id" domain="[('id', 'in', available_property_unit_ids)]"/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_confirm" string="Confirm" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
</odoo>
