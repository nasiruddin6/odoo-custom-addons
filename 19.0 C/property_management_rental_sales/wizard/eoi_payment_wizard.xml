<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_eoi_payment_wizard_form" model="ir.ui.view">
            <field name="name">eoi.payment.wizard.form</field>
            <field name="model">eoi.payment.wizard</field>
            <field name="arch" type="xml">
                <form string="EOI Payment">
                    <sheet>
	                    <group>
		                    <group>
			                    <field name="journal_id" required="1"/>
			                    <field name="payment_method_id" required="1"/>
			                    <field name="partner_bank_id"/>
			                    <field name="cheque_number"/>
		                    </group>
		                    <group>
			                    <field name="eoi_amount" required="wiz_for == 'eoi'" invisible="wiz_for != 'eoi'"/>
			                    <field name="amount" required="wiz_for != 'eoi'" invisible="wiz_for == 'eoi'"/>
			                    <field name="date"/>
			                    <field name="eoi_expiration" widget="date" invisible="wiz_for != 'eoi'"/>
		                    </group>
		                    <group string="Payment Details" invisible="1">
			                    <field name="currency_id" invisible="1"/>
			                    <field name="wiz_for" invisible="1"/>
			                    <field name="so_id" readonly="1"/>
			                    <field name="property_id" readonly="1"/>
			                    <field name="unit_id" readonly="1"/>
		                    </group>
	                    </group>
                    </sheet>
                    <footer>
                        <button name="action_create_payment" string="Register Payment" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
</odoo>
