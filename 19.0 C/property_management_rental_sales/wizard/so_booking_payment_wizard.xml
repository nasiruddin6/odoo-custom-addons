<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- SO Booking Payment Wizard Form View -->
        <record id="so_booking_payment_wizard_form" model="ir.ui.view">
            <field name="name">so.booking.payment.wizard.form</field>
            <field name="model">so.booking.payment.wizard</field>
            <field name="arch" type="xml">
                <form string="Register Payment">
                    <group>
                        <group>
                            <field name="booking_id" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount" required="1"/>
                        </group>
                        <group>
                            <field name="date" required="1"/>
                            <field name="journal_id" required="1"/>
                            <field name="payment_method_id" required="1"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="partner_bank_id"/>
                            <field name="cheque_number"/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_create_payment" string="Create Payment" type="object" class="oe_highlight"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
</odoo>
