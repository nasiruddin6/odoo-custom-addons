<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--SO booking wizard form view-->
		<record id="view_so_booking_wizard_form" model="ir.ui.view">
			<field name="name">view.so.booking.wizard.form</field>
			<field name="model">so.booking.wizard</field>
			<field name="arch" type="xml">
				<form>
					<sheet>
						<div class="oe_title">
							<h1>
								<field name="so_id" readonly="1"/>
							</h1>
						</div>
						<group>
							<group>
								<field name="partner_id"/>
							</group>
							<group>
								<field name="payment_plan_id"/>
							</group>
						</group>
						<footer>
							<button name="action_confirm" type="object" string="Confirm" class="oe_highlight"/>
							<button special="cancel" data-hotkey="x" string="Discard" class="btn-secondary"/>
						</footer>
					</sheet>
				</form>
			</field>
		</record>
</odoo>
