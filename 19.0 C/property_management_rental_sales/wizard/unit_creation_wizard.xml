<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Wizard form view -->
        <record id="view_unit_creation_wizard_form" model="ir.ui.view">
            <field name="name">unit.creation.wizard.form</field>
            <field name="model">unit.creation.wizard</field>
            <field name="arch" type="xml">
                <form string="Create Units">
                    <sheet>
                        <group>
                            <field name="property_id"/>
                            <field name="unit_prefix"/>
                            <field name="starting_number"/>
                        </group>
                        <group>
                            <field name="total_floor"/>
                            <field name="unit_per_floor"/>
                            <field name="total_unit" readonly="1"/>
                        </group>
                    </sheet>
                    <footer>
                        <button string="Create Units" type="object" name="create_units" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Action to open the wizard -->
        <record id="action_unit_creation_wizard" model="ir.actions.act_window">
            <field name="name">Create Units</field>
            <field name="res_model">unit.creation.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
</odoo>
