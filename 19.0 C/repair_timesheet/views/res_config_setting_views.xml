<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherited_custom" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.repair.timesheet</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='integration']" position="after">
                <block title="Repair" id="repair_settings">
                    <setting string="Repair Timesheet Product" help="Product used for repair timesheet entries">
                        <field name="repair_timesheet_product_id" options="{'no_create': True}"/>
                    </setting>
                </block>
            </xpath>

        </field>
    </record>
</odoo>