<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_purchase_inherit" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.purchase.notes</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='purchase_setting_container']" position="after">
                <block title="Purchase Notes" name="purchase_custom_notes_block">
                    <setting title="Purchase Notes" help="Set default HTML notes for RFQs">
                        <field name="purchase_rfq_note" widget="html" placeholder="Enter purchase HTML notes here..."/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>