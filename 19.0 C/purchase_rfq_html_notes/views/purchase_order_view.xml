<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_inherit_notes" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.purchase.notes</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet/notebook" position="inside">
                <page string="Purchase Notes">
                    <field name="purchase_notes"
                           widget="html"
                           placeholder="Write purchase notes here..."/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
