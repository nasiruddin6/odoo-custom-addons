<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_purchaseorder_document_inherit_notes" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//div[@class='page']" position="inside">
            <div t-if="o.purchase_notes" class="mt-4" style="page-break-inside: avoid;">
                <hr style="border-top: 1px solid #ccc;"/>
                <h5 style="color: #495057;">
                    <strong>Purchase Notes</strong>
                </h5>
                <div t-out="o.purchase_notes" style="font-size: 14px;"/>
            </div>
        </xpath>
    </template>

    <template id="report_purchasequotation_document_inherit_notes"
              inherit_id="purchase.report_purchasequotation_document">
        <xpath expr="//div[@class='page']" position="inside">
            <div t-if="o.purchase_notes" class="mt-4" style="page-break-inside: avoid;">
                <hr style="border-top: 1px solid #ccc;"/>
                <h5 style="color: #495057;">
                    <strong>Purchase Notes</strong>
                </h5>
                <div t-out="o.purchase_notes" style="font-size: 14px;"/>
            </div>
        </xpath>
    </template>
</odoo>