<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <!-- Cron Job: Update Lease Status -->
        <record id="ir_cron_update_lease_status" model="ir.cron">
            <field name="name">Property Lease: Update Status</field>
            <field name="model_id" ref="model_property_lease"/>
            <field name="state">code</field>
            <field name="code">model._cron_update_lease_status()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
            <field name="doall" eval="False"/>
        </record>

        <!-- Cron Job: Send Payment Reminders -->
        <record id="ir_cron_send_payment_reminders" model="ir.cron">
            <field name="name">Property Lease: Send Payment Reminders</field>
            <field name="model_id" ref="model_property_lease"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_payment_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
            <field name="doall" eval="False"/>
        </record>
    </data>
</odoo>

