<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- Styles -->
        <template id="report_property_contract_styles">
            <style>
                body { font-family: Helvetica, Arial, sans-serif; font-size: 16px; color: #333; }
                .page { page-break-after: always; padding: 20px; }
                .section-header { font-weight: 700; background-color: #2c3e50; color: #fff; padding: 8px 12px; margin-top: 15px; margin-bottom: 10px; font-size: 18px; }
                .info-box { padding: 8px; background-color: #ecf0f1; margin-bottom: 5px; }
                .data-table, .detail-table { width: 100%; border-collapse: collapse; margin-bottom: 10px; }
                .data-table td { border: 1px solid #ddd; padding: 6px; }
                .detail-table { border: 1px solid #ddd; }
                .detail-table td, .detail-table th { border: 1px solid #ddd; padding: 6px; }
                .detail-table thead { background-color: #2c3e50; color: white; font-weight: 600; }
                .text-right { text-align: right; }
                .text-center { text-align: center; }
                .text-start { text-align: left; }
                .status-badge { border-radius: 12px; padding: 3px 8px; font-size: 14px; font-weight: 600; display: inline-block; }
                .status-paid { background-color: #d4edda; color: #155724; }
                .status-pending { background-color: #fff3cd; color: #856404; }
                .status-processing { background-color: #cfe2ff; color: #084298; }
                .status-cancelled { background-color: #f8d7da; color: #721c24; }
                .status-active { background-color: #d4edda; color: #155724; }
                .status-draft { background-color: #d6d8db; color: #383d41; }
                .fw-bold { font-weight: 700; }
            </style>
        </template>

        <!-- Main Report -->
        <template id="property_contract" name="Property Contract Report">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <t t-call="property_management_rental_sales.report_property_contract_styles"/>

                    <t t-foreach="docs" t-as="doc">
                        <div class="page">

                            <!-- HEADER -->
                            <div class="section-header">Rental Contract - <t t-esc="doc.name"/></div>

                            <!-- Contract Information Row -->
                            <table class="data-table">
                                <tr>
                                    <td width="33%">
                                        <strong>Contract Ref:</strong><br/>
                                        <t t-esc="doc.name or 'N/A'"/>
                                    </td>
                                    <td width="33%">
                                        <strong>Start Date:</strong><br/>
                                        <t t-esc="doc.start_date.strftime('%d %b %Y') if doc.start_date else 'N/A'"/>
                                    </td>
                                    <td width="33%">
                                        <strong>Status:</strong><br/>
                                        <t t-if="doc.state == 'draft'">
                                            <span class="status-badge status-draft">DRAFT</span>
                                        </t>
                                        <t t-elif="doc.state == 'active'">
                                            <span class="status-badge status-active">ACTIVE</span>
                                        </t>
                                        <t t-elif="doc.state == 'settled'">
                                            <span class="status-badge status-paid">SETTLED</span>
                                        </t>
                                        <t t-else="">
                                            <t t-esc="doc.state"/>
                                        </t>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <strong>End Date:</strong><br/>
                                        <t t-esc="doc.end_date.strftime('%d %b %Y') if doc.end_date else 'N/A'"/>
                                    </td>
                                    <td>
                                        <strong>Duration:</strong><br/>
                                        <t t-if="doc.duration_id">
                                            <t t-esc="doc.duration_id.name or '—'"/>
                                        </t>
                                        <t t-else="">—</t>
                                    </td>
                                    <td>
                                        <strong>Payment Term:</strong><br/>
                                        <t t-if="doc.payment_term == 'monthly'">Monthly</t>
                                        <t t-elif="doc.payment_term == 'quarterly'">Quarterly</t>
                                        <t t-elif="doc.payment_term == 'yearly'">Yearly</t>
                                        <t t-else="">
                                            <t t-esc="doc.payment_term or '—'"/>
                                        </t>
                                    </td>
                                </tr>
                            </table>

                            <!-- Tenant & Landlord Information -->
                            <table class="data-table">
                                <tr>
                                    <td width="50%">
                                        <div class="info-box">
                                            <strong>Tenant Information:</strong><br/>
                                            <t t-esc="doc.partner_id.name"/><br/>
                                            <t t-if="doc.partner_id.email"><t t-esc="doc.partner_id.email"/><br/></t>
                                            <t t-if="doc.partner_id.phone"><t t-esc="doc.partner_id.phone"/><br/></t>
                                            <t t-if="doc.partner_id.mobile"><t t-esc="doc.partner_id.mobile"/><br/></t>
                                            <t t-if="doc.nationality">Nationality: <t t-esc="doc.nationality"/><br/></t>
                                            <t t-if="doc.responsible_id">Account Manager: <t t-esc="doc.responsible_id.name"/></t>
                                        </div>
                                    </td>
                                    <td width="50%">
                                        <div class="info-box">
                                            <strong>Landlord Information:</strong><br/>
                                            <t t-if="doc.landlord_id">
                                                <t t-esc="doc.landlord_id.name"/><br/>
                                                <t t-if="doc.landlord_id.email"><t t-esc="doc.landlord_id.email"/><br/></t>
                                                <t t-if="doc.landlord_id.phone"><t t-esc="doc.landlord_id.phone"/><br/></t>
                                                <t t-if="doc.landlord_id.mobile"><t t-esc="doc.landlord_id.mobile"/><br/></t>
                                                <t t-if="doc.landlord_id.street">
                                                    <t t-esc="doc.landlord_id.street"/>
                                                    <t t-if="doc.landlord_id.street2"> <t t-esc="doc.landlord_id.street2"/></t>
                                                    <br/>
                                                </t>
                                                <t t-if="doc.landlord_id.city"><t t-esc="doc.landlord_id.city"/></t>
                                            </t>
                                            <t t-else="">—</t>
                                        </div>
                                    </td>
                                </tr>
                            </table>

                            <!-- Property & Unit Information -->
                            <div class="section-header">PROPERTY &amp; UNIT DETAILS</div>
                            <table class="data-table">
                                <tr>
                                    <td width="50%">
                                        <strong>Property Name:</strong><br/>
                                        <t t-esc="doc.property_id.name or '—'"/>
                                    </td>
                                    <td width="50%">
                                        <strong>Property Code:</strong><br/>
                                        <t t-if="doc.property_id.code">
                                            <t t-esc="doc.property_id.code"/>
                                        </t>
                                        <t t-else="">—</t>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <strong>Property Type:</strong><br/>
                                        <t t-if="doc.property_type_id">
                                            <t t-esc="doc.property_type_id.name"/>
                                        </t>
                                        <t t-else="">—</t>
                                    </td>
                                    <td>
                                        <strong>Construction Status:</strong><br/>
                                        <t t-if="doc.property_id.construction_status">
                                            <t t-esc="doc.property_id.construction_status"/>
                                        </t>
                                        <t t-else="">—</t>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="2">
                                        <strong>Address:</strong><br/>
                                        <t t-esc="doc.street or ''"/>
                                        <t t-if="doc.street2"><br/><t t-esc="doc.street2"/></t>
                                        <t t-if="doc.city_id"><br/><t t-esc="doc.city_id.name"/></t>
                                        <t t-if="doc.state_id">, <t t-esc="doc.state_id.name"/></t>
                                        <t t-if="doc.country_id"><br/><t t-esc="doc.country_id.name"/></t>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <strong>Unit Name:</strong><br/>
                                        <t t-esc="doc.unit_id.name or '—'"/>
                                    </td>
                                    <td>
                                        <strong>Unit Code:</strong><br/>
                                        <t t-if="doc.unit_id.code">
                                            <t t-esc="doc.unit_id.code"/>
                                        </t>
                                        <t t-else="">—</t>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <strong>Floor:</strong><br/>
                                        <t t-if="doc.unit_id.floor">
                                            <t t-esc="doc.unit_id.floor"/>
                                        </t>
                                        <t t-else="">—</t>
                                    </td>
                                    <td>
                                        <strong>Building:</strong><br/>
                                        <t t-if="doc.unit_id.building">
                                            <t t-esc="doc.unit_id.building"/>
                                        </t>
                                        <t t-else="">—</t>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <strong>Area (sqft):</strong><br/>
                                        <t t-if="doc.unit_id.area_sqft">
                                            <t t-esc="doc.unit_id.area_sqft"/>
                                        </t>
                                        <t t-else="">—</t>
                                    </td>
                                    <td>
                                        <strong>Area (sqm):</strong><br/>
                                        <t t-if="doc.unit_id.area_sqm">
                                            <t t-esc="doc.unit_id.area_sqm"/>
                                        </t>
                                        <t t-else="">—</t>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <strong>Bedrooms:</strong><br/>
                                        <t t-if="doc.unit_id.bedroom">
                                            <t t-esc="doc.unit_id.bedroom"/>
                                        </t>
                                        <t t-else="">—</t>
                                    </td>
                                    <td>
                                        <strong>Unit Type:</strong><br/>
                                        <t t-if="doc.unit_id.unit_type">
                                            <t t-esc="doc.unit_id.unit_type"/>
                                        </t>
                                        <t t-else="">—</t>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <strong>Unit Status:</strong><br/>
                                        <t t-if="doc.unit_id.state == 'available'">Available</t>
                                        <t t-elif="doc.unit_id.state == 'rented'">Rented</t>
                                        <t t-elif="doc.unit_id.state == 'booked'">Booked</t>
                                        <t t-elif="doc.unit_id.state == 'maintenance'">Maintenance</t>
                                        <t t-elif="doc.unit_id.state == 'sold'">Sold</t>
                                        <t t-else="">
                                            <t t-esc="doc.unit_id.state or '—'"/>
                                        </t>
                                    </td>
                                    <td>
                                        <strong>Nationality:</strong><br/>
                                        <t t-if="doc.nationality">
                                            <t t-esc="doc.nationality"/>
                                        </t>
                                        <t t-else="">—</t>
                                    </td>
                                </tr>
                            </table>

                            <!-- Financial Summary -->
                            <div class="section-header">FINANCIAL INFORMATION</div>
                            <table class="data-table">
                                <tr>
                                    <td width="50%">
                                        <strong>Rent Amount:</strong><br/>
                                        <t t-esc="doc.contract_value or '0.00'"/>
                                    </td>
                                    <td width="50%">
                                        <strong>Security Deposit:</strong><br/>
                                        <t t-if="doc.security_deposit">
                                            <t t-esc="doc.security_deposit"/>
                                        </t>
                                        <t t-else="">—</t>
                                    </td>
                                </tr>
                            </table>

                            <!-- Rent Installments Section -->
                            <t t-if="doc.installment_ids">
                                <div class="section-header">RENT INSTALLMENTS</div>
                                <table class="detail-table">
                                    <thead>
                                        <tr>
                                            <th class="text-start">Type</th>
                                            <th class="text-start">Invoice Date</th>
                                            <th class="text-start">Description</th>
                                            <th class="text-right">Amount</th>
                                            <th class="text-start">Invoice</th>
                                            <th class="text-center">Payment Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="doc.installment_ids" t-as="line">
                                            <tr>
                                                <td class="text-start">
                                                    <t t-if="line.invoice_type == 'rent'">Rent</t>
                                                    <t t-elif="line.invoice_type == 'maintenance'">Maintenance</t>
                                                    <t t-elif="line.invoice_type == 'deposit'">Deposit</t>
                                                    <t t-elif="line.invoice_type == 'penalty'">Penalty</t>
                                                    <t t-elif="line.invoice_type == 'fees'">Fees</t>
                                                    <t t-elif="line.invoice_type == 'other'">Other</t>
                                                    <t t-else=""><t t-esc="line.invoice_type"/></t>
                                                </td>
                                                <td class="text-start"><t t-esc="line.invoice_date.strftime('%d %b %Y') if line.invoice_date else '—'"/></td>
                                                <td class="text-start"><t t-esc="line.description or '—'"/></td>
                                                <td class="text-right"><t t-esc="line.amount or 0"/></td>
                                                <td class="text-start">
                                                    <t t-if="line.invoice_id">
                                                        <t t-esc="line.invoice_id.name"/>
                                                    </t>
                                                    <t t-else="">—</t>
                                                </td>
                                                <td class="text-center">
                                                    <t t-if="line.payment_status == 'paid'">
                                                        <span class="status-badge status-paid">PAID</span>
                                                    </t>
                                                    <t t-elif="line.payment_status == 'in_payment'">
                                                        <span class="status-badge status-processing">IN PAYMENT</span>
                                                    </t>
                                                    <t t-elif="line.payment_status == 'partial'">
                                                        <span class="status-badge status-pending">PARTIAL</span>
                                                    </t>
                                                    <t t-elif="line.payment_status == 'not_paid'">
                                                        <span class="status-badge status-cancelled">NOT PAID</span>
                                                    </t>
                                                    <t t-else="">
                                                        <span class="status-badge status-draft"><t t-esc="line.payment_status"/></span>
                                                    </t>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </t>

                            <!-- Payment Schedules Section -->
                            <t t-if="doc.payment_schedule_ids">
                                <div class="section-header">PAYMENT SCHEDULES</div>
                                <table class="detail-table">
                                    <thead>
                                        <tr>
                                            <th class="text-start">Type</th>
                                            <th class="text-start">Journal</th>
                                            <th class="text-right">Amount</th>
                                            <th class="text-start">Due Date</th>
                                            <th class="text-start">Payment Method</th>
                                            <th class="text-start">Bank</th>
                                            <th class="text-start">Cheque No.</th>
                                            <th class="text-center">PDC</th>
                                            <th class="text-start">Payment</th>
                                            <th class="text-center">Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="doc.payment_schedule_ids" t-as="line">
                                            <tr>
                                                <td class="text-start">
                                                    <t t-if="line.type == 'rent'">Rent</t>
                                                    <t t-elif="line.type == 'maintenance'">Maintenance</t>
                                                    <t t-elif="line.type == 'deposit'">Deposit</t>
                                                    <t t-elif="line.type == 'penalty'">Penalty</t>
                                                    <t t-elif="line.type == 'fees'">Fees</t>
                                                    <t t-elif="line.type == 'other'">Other</t>
                                                    <t t-else=""><t t-esc="line.type"/></t>
                                                </td>
                                                <td class="text-start">
                                                    <t t-if="line.journal_id">
                                                        <t t-esc="line.journal_id.name"/>
                                                    </t>
                                                    <t t-else="">—</t>
                                                </td>
                                                <td class="text-right"><t t-esc="line.amount or 0"/></td>
                                                <td class="text-start"><t t-esc="line.due_date.strftime('%d %b %Y') if line.due_date else '—'"/></td>
                                                <td class="text-start">
                                                    <t t-if="line.payment_method_id">
                                                        <t t-esc="line.payment_method_id.name"/>
                                                    </t>
                                                    <t t-else="">—</t>
                                                </td>
                                                <td class="text-start">
                                                    <t t-if="line.partner_bank_id">
                                                        <t t-esc="line.partner_bank_id.name"/>
                                                    </t>
                                                    <t t-else="">—</t>
                                                </td>
                                                <td class="text-start">
                                                    <t t-if="line.cheque_number">
                                                        <t t-esc="line.cheque_number"/>
                                                    </t>
                                                    <t t-else="">—</t>
                                                </td>
                                                <td class="text-center">
                                                    <t t-if="line.is_pdc">
                                                        <span class="status-badge status-active">YES</span>
                                                    </t>
                                                    <t t-else="">
                                                        <span class="status-badge status-cancelled">NO</span>
                                                    </t>
                                                </td>
                                                <td class="text-start">
                                                    <t t-if="line.payment_id">
                                                        <t t-esc="line.payment_id.name"/>
                                                    </t>
                                                    <t t-else="">—</t>
                                                </td>
                                                <td class="text-center">
                                                    <t t-if="line.payment_status == 'paid'">
                                                        <span class="status-badge status-paid">PAID</span>
                                                    </t>
                                                    <t t-elif="line.payment_status == 'posted'">
                                                        <span class="status-badge status-paid">POSTED</span>
                                                    </t>
                                                    <t t-elif="line.payment_status == 'in_process'">
                                                        <span class="status-badge status-processing">IN PROCESS</span>
                                                    </t>
                                                    <t t-elif="line.payment_status == 'draft'">
                                                        <span class="status-badge status-draft">DRAFT</span>
                                                    </t>
                                                    <t t-elif="line.payment_status in ('canceled', 'rejected', 'cancel')">
                                                        <span class="status-badge status-cancelled">CANCELLED</span>
                                                    </t>
                                                    <t t-else="">
                                                        <span class="status-badge status-pending"><t t-esc="line.payment_status"/></span>
                                                    </t>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </t>

                            <!-- Contract Agreement -->
                            <t t-if="doc.contract_agreement">
                                <div class="section-header" style="margin-top: 20px;">CONTRACT AGREEMENT</div>
                                <div style="padding: 10px; background-color: #f9f9f9; border: 1px solid #ddd;">
                                    <div t-field="doc.contract_agreement"/>
                                </div>
                            </t>

                            <!-- Terms & Conditions -->
                            <t t-if="doc.terms_and_conditions">
                                <div class="section-header" style="margin-top: 20px;">TERMS &amp; CONDITIONS</div>
                                <div style="padding: 10px; background-color: #f9f9f9; border: 1px solid #ddd;">
                                    <div t-field="doc.terms_and_conditions"/>
                                </div>
                            </t>

                        </div>
                    </t>

                </t>
            </t>
        </template>
    </data>
</odoo>
