<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- Styles -->
        <template id="report_sale_contract_styles">
            <style>
                body { font-family: Helvetica, Arial, sans-serif; font-size: 16px; color: #333; }
                .page { page-break-after: always; padding: 20px; }
                .section-header { font-weight: 700; background-color: #2c3e50; color: #fff; padding: 8px 12px; margin-top: 15px; margin-bottom: 10px; font-size: 18px; }
                .info-box { padding: 8px; background-color: #ecf0f1; margin-bottom: 5px; }
                .data-table, .detail-table, .amount-table { width: 100%; border-collapse: collapse; margin-bottom: 10px; }
                .data-table td { border: 1px solid #ddd; padding: 6px; }
                .detail-table { border: 1px solid #ddd; }
                .detail-table td, .detail-table th { border: 1px solid #ddd; padding: 6px; }
                .detail-table thead { background-color: #2c3e50; color: white; font-weight: 600; }
                .amount-table td { border-bottom: 1px solid #ddd; padding: 6px; }
                .amount-table tr:last-child td { border-bottom: 2px solid #2c3e50; }
                .text-right { text-align: right; }
                .text-center { text-align: center; }
                .text-start { text-align: left; }
                .status-badge { border-radius: 12px; padding: 3px 8px; font-size: 14px; font-weight: 600; display: inline-block; }
                .status-paid { background-color: #d4edda; color: #155724; }
                .status-pending { background-color: #fff3cd; color: #856404; }
                .status-processing { background-color: #cfe2ff; color: #084298; }
                .fw-bold { font-weight: 700; }
                .mb-3 { margin-bottom: 15px; }
                .breakdown-section { margin-bottom: 20px; }
                h5 { font-weight: 600; margin-bottom: 10px; margin-top: 0; }
                table.order-lines { width: 100%; }
                table.order-lines thead { background-color: #f8f9fa; }
                table.order-lines th { border-bottom: 2px solid #ddd; padding: 8px; font-weight: 600; }
                table.order-lines td { padding: 6px; border-bottom: 1px solid #ddd; }
            </style>
        </template>

        <!-- Main Report -->
        <template id="report_sale_contract">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <t t-call="property_management_rental_sales.report_sale_contract_styles"/>

                    <t t-foreach="docs" t-as="sale_order">
                        <div class="page">

                            <!-- HEADER -->
                            <div class="section-header">Sales Contract - <t t-esc="sale_order.name"/></div>

                            <!-- Contract Information Row -->
                            <table class="data-table">
                                <tr>
                                    <td width="33%">
                                        <strong>Contract Ref:</strong><br/>
                                        <t t-esc="sale_order.name or 'N/A'"/>
                                    </td>
                                    <td width="33%">
                                        <strong>Date:</strong><br/>
                                        <t t-if="sale_order.state in ['sale', 'cancel']">Order Date: </t>
                                        <t t-else="">Date: </t>
                                        <t t-esc="sale_order.date_order.strftime('%d %b %Y') if sale_order.date_order else 'N/A'"/>
                                    </td>
                                    <td width="33%">
                                        <strong>Status:</strong><br/>
                                        <t t-esc="dict(sale_order._fields['state'].selection).get(sale_order.state, sale_order.state)"/>
                                    </td>
                                </tr>
                                <t t-if="sale_order.validity_date and sale_order.state in ['draft', 'sent']">
                                    <tr>
                                        <td colspan="2">
                                            <strong>Expiration Date:</strong><br/>
                                            <t t-esc="sale_order.validity_date.strftime('%d %b %Y') if sale_order.validity_date else 'N/A'"/>
                                        </td>
                                        <td><strong>Your Reference:</strong><br/>
                                            <t t-esc="sale_order.client_order_ref or '—'"/>
                                        </td>
                                    </tr>
                                </t>
                            </table>

                            <!-- Customer Information -->
                            <table class="data-table">
                                <tr>
                                    <td width="50%">
                                        <div class="info-box">
                                            <strong>Seller (Company):</strong><br/>
                                            <t t-esc="sale_order.company_id.name"/><br/>
                                            <t t-esc="sale_order.company_id.street or ''"/><br/>
                                            <t t-esc="sale_order.company_id.city or ''"/>
                                        </div>
                                    </td>
                                    <td width="50%">
                                        <div class="info-box">
                                            <strong>Buyer (Customer):</strong><br/>
                                            <t t-esc="sale_order.partner_id.name"/><br/>
                                            <t t-esc="sale_order.partner_id.street or ''"/><br/>
                                            <t t-esc="sale_order.partner_id.city or ''"/>
                                        </div>
                                    </td>
                                </tr>
                            </table>

                            <!-- Property &amp; Unit Information -->
                            <div class="section-header">PROPERTY &amp; UNIT DETAILS</div>
                            <table class="data-table">
                                <tr>
                                    <td width="50%">
                                        <strong>Property:</strong><br/>
                                        <t t-esc="sale_order.property_id.name or '—'"/>
                                    </td>
                                    <td width="50%">
                                        <strong>Unit:</strong><br/>
                                        <t t-esc="sale_order.unit_id.name or '—'"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <strong>Unit Type:</strong><br/>
                                        <t t-esc="sale_order.unit_id.property_unit_type_id.name if sale_order.unit_id and sale_order.unit_id.property_unit_type_id else '—'"/>
                                    </td>
                                    <td>
                                        <strong>Area (sqft):</strong><br/>
                                        <t t-esc="sale_order.unit_id.area_sqft or '—'"/>
                                    </td>
                                </tr>
                            </table>

                            <!-- Order Lines -->
                            <div class="section-header">ORDER LINES</div>
                            <table class="order-lines">
                                <thead>
                                    <tr>
                                        <th class="text-start">Property</th>
                                        <th class="text-right">Price</th>
                                        <th class="text-right">Disc.%</th>
                                        <th class="text-right">Taxes</th>
                                        <th class="text-right">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="lines_to_report" t-value="sale_order._get_order_lines_to_report()"/>
                                    <t t-foreach="lines_to_report" t-as="line">
                                        <t t-if="not line.display_type and line.product_type != 'combo'">
                                            <tr>
                                                <td class="text-start">
                                                    <t t-esc="line.name"/>
                                                </td>
                                                <td class="text-right">
                                                    <t t-esc="line.price_unit"/>
                                                </td>
                                                <td class="text-right">
                                                    <t t-if="line.discount &gt; 0">
                                                        <t t-out="((line.discount % 1) and '%s' or '%d') % line.discount"/>%
                                                    </t>
                                                </td>
                                                <td class="text-right">
                                                    <t t-esc="', '.join(map(lambda x: x.name, line.tax_id)) or '—'"/>
                                                </td>
                                                <td class="text-right" t-if="not line.is_downpayment">
                                                    <t t-esc="line.price_subtotal"/>
                                                </td>
                                            </tr>
                                        </t>
                                        <t t-if="line.display_type == 'line_section' or line.product_type == 'combo'">
                                            <tr>
                                                <td colspan="5" class="fw-bold">
                                                    <t t-esc="line.name"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </t>
                                </tbody>
                            </table>

                            <!-- Payment Plan & Breakdown -->
                            <div class="section-header">PAYMENT PLAN &amp; BREAKDOWN</div>
                            <table class="amount-table">
                                <tr>
                                    <td width="50%"><strong>Unit Price:</strong></td>
                                    <td class="text-right"><t t-esc="sale_order.unit_price_amount or 0"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Down Payment:</strong></td>
                                    <td class="text-right"><t t-esc="sale_order.down_payment_amount or 0"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Pre-Handover Payment:</strong></td>
                                    <td class="text-right"><t t-esc="sale_order.pre_handover_amount or 0"/></td>
                                </tr>
                                <t t-if="sale_order.on_handover_amount">
                                    <tr>
                                        <td><strong>On-Handover Payment:</strong></td>
                                        <td class="text-right"><t t-esc="sale_order.on_handover_amount or 0"/></td>
                                    </tr>
                                </t>
                                <tr>
                                    <td><strong>Post-Handover Payment:</strong></td>
                                    <td class="text-right"><t t-esc="sale_order.post_handover_amount or 0"/></td>
                                </tr>
                                <t t-if="sale_order.amount_per_installment">
                                    <tr>
                                        <td><strong>Amount Per Installment:</strong></td>
                                        <td class="text-right"><t t-esc="sale_order.amount_per_installment or 0"/></td>
                                    </tr>
                                </t>
                            </table>

                            <!-- Additional Fees -->
                            <div t-if="sale_order.admin_fee or sale_order.stamp_duty_fee or sale_order.registration_fee or sale_order.mutation_fee or sale_order.others_fee" class="section-header">Additional Fees</div>
                            <table class="amount-table table table-sm">
                                <t t-if="sale_order.admin_fee">
                                    <tr>
                                        <td width="50%"><strong>Admin Fee:</strong></td>
                                        <td class="text-right"><t t-esc="sale_order.admin_fee or 0"/></td>
                                    </tr>
                                </t>
                                <t t-if="sale_order.stamp_duty_fee">
                                    <tr>
                                        <td><strong>Stamp Duty Fee:</strong></td>
                                        <td class="text-right"><t t-esc="sale_order.stamp_duty_fee or 0"/></td>
                                    </tr>
                                </t>
                                <t t-if="sale_order.registration_fee">
                                    <tr>
                                        <td><strong>Registration Fee:</strong></td>
                                        <td class="text-right"><t t-esc="sale_order.registration_fee or 0"/></td>
                                    </tr>
                                </t>
                                <t t-if="sale_order.mutation_fee">
                                    <tr>
                                        <td><strong>Mutation Fee:</strong></td>
                                        <td class="text-right"><t t-esc="sale_order.mutation_fee or 0"/></td>
                                    </tr>
                                </t>
                                <t t-if="sale_order.others_fee">
                                    <tr>
                                        <td><strong>Others Fees:</strong></td>
                                        <td class="text-right"><t t-esc="sale_order.others_fee or 0"/></td>
                                    </tr>
                                </t>
                                <t t-if="sale_order.total_fees">
                                    <tr class="fw-bold">
                                        <td><strong>Total Fees:</strong></td>
                                        <td class="text-right"><t t-esc="sale_order.total_fees or 0"/></td>
                                    </tr>
                                </t>
                            </table>

                            <!-- Installment Plan -->
                            <t t-if="sale_order.installment_ids">
                                <div class="section-header">INSTALLMENT PLAN</div>
                                <table class="detail-table">
                                    <thead>
                                        <tr>
                                            <th class="text-start">Installment #</th>
                                            <th class="text-start">Invoice Date</th>
                                            <th class="text-right">Amount</th>
                                            <th class="text-right">VAT</th>
                                            <th class="text-start">Payment Date</th>
                                            <th class="text-center">Payment Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="sale_order.installment_ids" t-as="line">
                                            <tr>
                                                <td class="text-start"><t t-esc="line.name"/></td>
                                                <td class="text-start"><t t-esc="line.invoice_date.strftime('%d %b %Y') if line.invoice_date else '—'"/></td>
                                                <td class="text-right"><t t-esc="line.amount or 0"/></td>
                                                <td class="text-right"><t t-esc="line.vat or 0"/></td>
                                                <td class="text-start"><t t-esc="line.payment_date.strftime('%d %b %Y') if line.payment_date else '—'"/></td>
                                                <td class="text-center">
                                                    <t t-if="line.payment_state == 'paid'">
                                                        <span class="status-badge status-paid">PAID</span>
                                                    </t>
                                                    <t t-elif="line.payment_state == 'in_payment'">
                                                        <span class="status-badge status-processing">PROCESSING</span>
                                                    </t>
                                                    <t t-else="">
                                                        <span class="status-badge status-pending">PENDING</span>
                                                    </t>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </t>

                            <!-- Terms & Conditions -->
                            <t t-if="not is_html_empty(sale_order.note)">
                                <div class="section-header" style="margin-top: 20px;">TERMS &amp; CONDITIONS</div>
                                <div style="padding: 10px; background-color: #f9f9f9; border: 1px solid #ddd;">
                                    <t t-esc="sale_order.note"/>
                                </div>
                            </t>

                            <!-- Payment Terms -->
                            <t t-if="sale_order.payment_term_id">
                                <div class="section-header" style="margin-top: 20px;">PAYMENT TERMS</div>
                                <div style="padding: 10px; background-color: #f9f9f9; border: 1px solid #ddd;">
                                    <t t-esc="sale_order.payment_term_id.note"/>
                                </div>
                            </t>

                        </div>
                    </t>

                </t>
            </t>
        </template>
    </data>
</odoo>