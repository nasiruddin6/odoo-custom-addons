<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="view_property_visit_reschedule_wizard_form" model="ir.ui.view">
            <field name="name">view.property.visit.reschedule.wizard.form</field>
            <field name="model">property.visit.reschedule.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="lead_id" nolabel="1" readonly="1" placeholder="NEW VISITING"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="date"/>
                            </group>
                            <group>

                                <field name="start" widget="daterange"
                                       options="{'end_date_field': 'end'}"/>
                                <field name="end" invisible="1"/>
                            </group>
                        </group>
                        <footer>
                            <button name="action_re_schedule" string="Re-Schedule" type="object" class="oe_highlight"/>
                            <button special="cancel" data-hotkey="x" string="Discard" class="btn-secondary"/>
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>