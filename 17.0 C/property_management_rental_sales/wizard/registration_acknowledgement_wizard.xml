<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
	<data>
		<record id="view_registration_acknowledgement_wizard_form" model="ir.ui.view">
			<field name="name">view.registration.acknowledgement.wizard.form</field>
			<field name="model">registration.acknowledgement.wizard</field>
			<field name="arch" type="xml">
				<form>
					<sheet>
						<div class="oe_title" invisible="1">
							<label for="so_id" string="Contract"/>
							<h1>
								<field name="so_id" readonly="1"/>
							</h1>
						</div>
						
						<group>
							<field name="message" nolabel="1" readonly="1"/>
						</group>
						<group invisible="1">
							<field name="wiz_for" />
						</group>
						<footer>
							<button name="action_confirm" type="object" string="Confirm" class="oe_highlight"/>
							<button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
						</footer>
					</sheet>
				</form>
			</field>
		</record>
	</data>
</odoo>