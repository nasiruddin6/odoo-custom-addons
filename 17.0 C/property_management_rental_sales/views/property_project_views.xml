<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="property_project_list_view" model="ir.ui.view">
            <field name="name">property.project.list</field>
            <field name="model">property.project</field>
            <field name="arch" type="xml">
                <tree string="Property Projects">
                    <field name="project_code"/>
                    <field name="name"/>
                    <field name="project_type"/>
                    <field name="project_category"/>
                    <field name="owner_id"/>
                    <field name="state" widget="badge"
                        decoration-success="state == 'active'"
                        decoration-info="state == 'planning'"
                        decoration-warning="state == 'on_hold'"
                        decoration-muted="state == 'completed'"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </tree>
            </field>
        </record>

        <!-- Property Project Form View -->
        <record id="property_project_form_view" model="ir.ui.view">
            <field name="name">property.project.form</field>
            <field name="model">property.project</field>
            <field name="arch" type="xml">
                <form string="Property Project">
                    <header>
                        <button name="action_activate"
                            string="Activate"
                            type="object"
                            class="btn-primary"
                            invisible="state == 'active'"
                            confirm="Are you sure you want to activate this project?"/>
                        <button name="action_complete"
                            string="Complete"
                            type="object"
                            class="btn-success"
                            invisible="state == 'completed'"
                            confirm="Are you sure you want to mark this project as completed?"/>
                        <button name="action_set_on_hold"
                            string="Set On Hold"
                            type="object"
                            invisible="state == 'on_hold'"/>
                        <button name="action_set_planning"
                            string="Back to Planning"
                            type="object"
                            invisible="state == 'planning'"/>
                        <field name="state" widget="statusbar"
                            statusbar_visible="planning,active,completed"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_properties"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-building">
                                <field name="property_count" widget="statinfo" string="Properties"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1>
                                <field name="name"
                                    placeholder="Project Name"
                                    readonly="state in ['active', 'completed']"/>
                            </h1>
                            <h3>
                                <field name="project_code" readonly="1"/>
                            </h3>
                        </div>
                        <group>
                            <group>
                                <field name="project_type"
                                    readonly="state in ['active', 'completed']"/>
                                <field name="project_category"
                                    readonly="state in ['active', 'completed']"/>
                                <field name="owner_id"
                                    readonly="state in ['active', 'completed']"/>
                            </group>
                            <group>
                                <field name="company_id"
                                    groups="base.group_multi_company"
                                    readonly="state in ['active', 'completed']"/>
                                <field name="active" invisible="1"/>
                            </group>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Property Project Kanban View -->
        <record id="property_project_kanban_view" model="ir.ui.view">
            <field name="name">property.project.kanban</field>
            <field name="model">property.project</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile">
                    <field name="name"/>
                    <field name="project_code"/>
                    <field name="project_type"/>
                    <field name="project_category"/>
                    <field name="state"/>
                    <field name="owner_id"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                        <span class="o_kanban_record_subtitle">
                                            (<field name="project_code"/>)
                                        </span>
                                    </div>
                                    <field name="state" widget="label_selection"
                                        options="{'classes': {'planning': 'info', 'active': 'success', 'on_hold': 'warning', 'completed': 'default'}}"/>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <span><i class="fa fa-building"/> <field name="project_type"/></span><br/>
                                        <span><i class="fa fa-tags"/> <field name="project_category"/></span>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="owner_id" widget="many2one_avatar_user"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Property Project Search View -->
        <record id="property_project_search_view" model="ir.ui.view">
            <field name="name">property.project.search</field>
            <field name="model">property.project</field>
            <field name="arch" type="xml">
                <search string="Property Projects">
                    <field name="name"/>
                    <field name="project_code"/>
                    <field name="owner_id"/>
                    <filter string="Rental" name="filter_rental"
                        domain="[('project_type', '=', 'rental')]"/>
                    <filter string="Sales" name="filter_sales"
                        domain="[('project_type', '=', 'sales')]"/>
                    <filter string="Mixed" name="filter_mixed"
                        domain="[('project_type', '=', 'mixed')]"/>
                    <filter string="Facility Management" name="filter_facility"
                        domain="[('project_type', '=', 'facility')]"/>
                    <separator/>
                    <filter string="Active" name="filter_active"
                        domain="[('state', '=', 'active')]"/>
                    <filter string="Planning" name="filter_planning"
                        domain="[('state', '=', 'planning')]"/>
                    <filter string="On Hold" name="filter_on_hold"
                        domain="[('state', '=', 'on_hold')]"/>
                    <filter string="Completed" name="filter_completed"
                        domain="[('state', '=', 'completed')]"/>
                    <separator/>
                    <filter string="Archived" name="inactive"
                        domain="[('active', '=', False)]"/>
                    <group expand="0" string="Group By">
                        <filter string="Project Type" name="group_project_type"
                            context="{'group_by': 'project_type'}"/>
                        <filter string="Project Category" name="group_project_category"
                            context="{'group_by': 'project_category'}"/>
                        <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                        <filter string="Owner" name="group_owner"
                            context="{'group_by': 'owner_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Property Project Action -->
        <record id="action_property_project" model="ir.actions.act_window">
            <field name="name">Projects</field>
            <field name="res_model">property.project</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first Property Project
                </p>
                <p>
                    Manage your property projects for rental, sales, or facility management.
                </p>
            </field>
        </record>

        <!-- Menu Item -->
        <menuitem id="menu_property_project"
            name="Projects"
            parent="menu_property_management"
            action="action_property_project"
            sequence="35"/>

    </data>
</odoo>

