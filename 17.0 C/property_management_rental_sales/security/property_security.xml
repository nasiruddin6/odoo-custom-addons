<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.module.category" id="module_category_property_management">
            <field name="name">Property</field>
            <field name="description">Helps you manage your Properties.</field>
            <field name="sequence">18</field>
        </record>

        <record id="group_property_tenant" model="res.groups">
            <field name="name">Tenant</field>
            <field name="category_id" ref="module_category_property_management"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_property_landlord" model="res.groups">
            <field name="name">Landlord</field>
            <field name="category_id" ref="module_category_property_management"/>
            <field name="implied_ids" eval="[(4, ref('group_property_tenant'))]"/>
        </record>

        <record id="group_property_agent" model="res.groups">
            <field name="name">Agent</field>
            <field name="category_id" ref="module_category_property_management"/>
            <field name="implied_ids" eval="[(4, ref('group_property_landlord'))]"/>
        </record>

        <record id="group_property_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_property_management"/>
            <field name="implied_ids" eval="[(4, ref('group_property_agent'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

    </data>
</odoo>

