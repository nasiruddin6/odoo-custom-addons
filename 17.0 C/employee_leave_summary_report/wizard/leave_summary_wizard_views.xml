<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_leave_summary_wizard_form" model="ir.ui.view">
        <field name="name">leave.summary.wizard.form</field>
        <field name="model">leave.summary.wizard</field>
        <field name="arch" type="xml">
            <form string="Employee Leave Summary Report">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="employee_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="date_to"/>
                        <field name="status"/>
                    </group>
                </group>
                <footer>
                    <button name="action_export_excel" string="Export" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_leave_summary_wizard" model="ir.actions.act_window">
        <field name="name">Employee Leave Summary Report</field>
        <field name="res_model">leave.summary.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>

