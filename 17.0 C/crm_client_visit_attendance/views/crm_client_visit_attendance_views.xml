    <!-- CRM Client Visit Attendance Actions -->
    <record id="action_crm_client_visit_attendance" model="ir.actions.act_window">
        <field name="name">Visit Attendance</field>
        <field name="res_model">crm.client.visit.attendance</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">
                No attendance records found
            </p>
            <p>
                Attendance records are automatically created when employees check in to visits.
