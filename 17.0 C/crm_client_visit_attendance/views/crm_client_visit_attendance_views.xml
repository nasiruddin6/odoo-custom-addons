<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- CRM Client Visit Attendance List View -->
    <record id="view_crm_client_visit_attendance_tree" model="ir.ui.view">
        <field name="name">crm.client.visit.attendance.tree</field>
        <field name="model">crm.client.visit.attendance</field>
        <field name="arch" type="xml">
            <tree string="Visit Attendance"
                  create="false"
                  decoration-success="attendance_type == 'present'"
                  decoration-warning="attendance_type == 'late'"
                  decoration-info="attendance_type == 'partial'"
                  decoration-danger="attendance_type == 'absent'">
                <field name="visit_id"/>
                <field name="employee_id"/>
                <field name="client_id"/>
                <field name="visit_type"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="duration" widget="float_time"/>
                <field name="attendance_type" widget="badge"
                       decoration-success="attendance_type == 'present'"
                       decoration-warning="attendance_type == 'late'"
                       decoration-info="attendance_type == 'partial'"
                       decoration-danger="attendance_type == 'absent'"/>
                <field name="hr_attendance_id" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- CRM Client Visit Attendance Form View -->
    <record id="view_crm_client_visit_attendance_form" model="ir.ui.view">
        <field name="name">crm.client.visit.attendance.form</field>
        <field name="model">crm.client.visit.attendance</field>
        <field name="arch" type="xml">
            <form string="Visit Attendance" create="false">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(hr_attendance.hr_attendance_action)d"
                                type="action"
                                class="oe_stat_button"
                                icon="fa-clock-o"
                                invisible="hr_attendance_id == False"
                                context="{'search_default_id': hr_attendance_id}">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">HR Attendance</span>
                            </div>
                        </button>
                    </div>

                    <widget name="web_ribbon" title="Present" bg_color="text-bg-success"
                            invisible="attendance_type != 'present'"/>
                    <widget name="web_ribbon" title="Late" bg_color="text-bg-warning"
                            invisible="attendance_type != 'late'"/>
                    <widget name="web_ribbon" title="Partial" bg_color="text-bg-info"
                            invisible="attendance_type != 'partial'"/>
                    <widget name="web_ribbon" title="Absent" bg_color="text-bg-danger"
                            invisible="attendance_type != 'absent'"/>

                    <group>
                        <group string="Visit Information">
                            <field name="visit_id" readonly="1"/>
                            <field name="employee_id" readonly="1"/>
                            <field name="client_id" readonly="1"/>
                            <field name="visit_type" readonly="1"/>
                        </group>
                        <group string="Attendance Details">
                            <field name="check_in"/>
                            <field name="check_out"/>
                            <!-- readonly="not context.get('is_manager', False)" -->
                            <field name="duration" widget="float_time" readonly="1"/>
                            <field name="attendance_type" readonly="1"/>
                        </group>
                    </group>

                    <group string="GPS Location">
                        <group>
                            <label for="latitude"/>
                            <div class="o_row">
                                <field name="latitude" readonly="1"/>
                                <span>, </span>
                                <field name="longitude" readonly="1"/>
                            </div>
                        </group>
                        <group>
                            <field name="hr_attendance_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

